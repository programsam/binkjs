if (jam.staff && jam.staff.length > 0)
  .list-group
    for staff in jam.staff
      li.list-group-item
        a(href=`javascript:loadEntity('staff', ${staff.id});`) #{staff.name}
        |&nbsp;-&nbsp;
        each role, index in staff.roles
          | #{role.name}&nbsp;
          a(href=`javascript:removeStaffRole(${staff.id}, ${role.id})`)
            i.fa-solid.fa-trash
          if (index === (staff.roles.length - 1))
            | &nbsp;
          else
            | ,&nbsp;
        p.float-end
          a(href=`javascript:removeEntireStaff(${staff.id})`)
            i.fa-solid.fa-user-minus
else
  em No staff.
.row.mt-3
  .col
    h5 Add New Staff
    .row
      .col
        p Name:
        .input-group
          input#addstaff.form-control(
            name="addstaff", 
            autocomplete="off", 
            placeholder="Select a staff member..."
          )
          button.btn.btn-primary(type="button")#clearStaffButton
            i.fa.fa-solid.fa-delete-left
      .col
        p Role:
        .input-group
          input#addrole.form-control(
            name="addrole", 
            autocomplete="off", 
            placeholder="Select a role..."
          )
          button.btn.btn-primary(type="button")#clearRoleButton
            i.fa.fa-solid.fa-delete-left

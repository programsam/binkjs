if (jam.musicians && jam.musicians.length > 0)
  .list-group
    for musician in jam.musicians
      li.list-group-item
        a(href=`javascript:loadEntity('musicians', ${musician.id});`) #{musician.name}
        |&nbsp;-&nbsp;
        each instrument, index in musician.instruments
          | #{instrument.name}&nbsp;
          a(href=`javascript:removeMusicianInstrument(${musician.id}, ${instrument.id})`)
            i.fa-solid.fa-trash
          if (index === (musician.instruments.length - 1))
            | &nbsp;
          else
            | ,&nbsp;
        p.float-end
          a(href=`javascript:removeEntireMusician(${musician.id})`)
            i.fa-solid.fa-user-minus
else
  em No musicians.
.row.mt-3
  .col
    h5 Add Another Musician
    .row
      .col
        p Name:
        .input-group
          input#addmusician.form-control(
            name="addmusician", 
            autocomplete="off", 
            placeholder="Select a musician..."
          )
          button.btn.btn-primary(type="button")#clearMusicianButton
            i.fa.fa-solid.fa-delete-left
      .col
        p Instrument:
        .input-group
          input#addinstrument.form-control(
            name="addinstrument", 
            autocomplete="off", 
            placeholder="Select an instrument..."
          )
          button.btn.btn-primary(type="button")#clearInstrumentButton
            i.fa.fa-solid.fa-delete-left
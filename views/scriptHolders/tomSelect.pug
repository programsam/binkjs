// Tom Select -- musicians, bands, instruments, producers, locations
//Had to abandon BootstrapAutcomplete because it didn't sync with backend database easily at ALL
script(src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js")
link(href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css", rel="stylesheet")
//By default, Tom Select's CSS gets written to some scary dark colors for dropdown menus
//Even for text.  Gotta override these to make sure admins can see what they are selecting.
style.
  .ts-dropdown .option,
  .ts-dropdown .create,
  .ts-dropdown .no-results {
    color: var(--bs-body-color, #fff) !important;
  }
  .ts-dropdown .option.active,
  .ts-dropdown .create.active {
    background-color: var(--bs-primary) !important;
    color: var(--bs-white) !important;
  }